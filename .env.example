# LLM providers (see src/libs/llm.ts — set keys for the providers you use)
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# anthropic | openai | openrouter (default: anthropic)
LLM_PROVIDER=anthropic

# MongoDB (sessions adapter + app data)
MONGODB_URI=

# NextAuth (Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Langfuse (optional — tracing)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
